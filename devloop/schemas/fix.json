{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "commit_message", "responses", "blocked_reason"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "blocked"]},
    "summary": {"type": "string"},
    "commit_message": {"type": "string"},
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "action", "note"],
        "properties": {
          "finding_id": {"type": "string"},
          "action": {"type": "string", "enum": ["fixed", "disputed", "not_applicable"]},
          "note": {"type": "string"}
        }
      }
    },
    "blocked_reason": {"type": "string"}
  }
}
