{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "phase": {
      "enum": [
        "06-ops",
        "07-docs"
      ]
    },
    "verified_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "diff": {
      "type": "object",
      "properties": {
        "included_chars": {
          "type": "integer",
          "minimum": 0
        },
        "total_chars": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "const": true
        }
      },
      "required": [
        "included_chars",
        "total_chars",
        "complete"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "included_chars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "total_chars": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "included_chars",
          "total_chars",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "full_audit_coverage_permitted": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "phase",
    "verified_commit",
    "tree",
    "diff",
    "inputs",
    "full_audit_coverage_permitted"
  ],
  "additionalProperties": false
}
