{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "target_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "plan_revision",
    "manifest_revision",
    "target_files",
    "reason",
    "sha256"
  ],
  "additionalProperties": false
}
