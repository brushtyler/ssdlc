{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "candidate_evidence_decision"
    },
    "gate": {
      "enum": [
        "review",
        "qa",
        "appsec"
      ]
    },
    "attempt": {
      "type": "integer"
    },
    "check_id": {
      "type": "string",
      "maxLength": 1024
    },
    "decision": {
      "enum": [
        "executed",
        "reused",
        "invalidated"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "considered": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "maxItems": 16
    },
    "considered_total": {
      "type": "integer"
    },
    "declined": {
      "type": "string",
      "maxLength": 1024
    }
  },
  "required": [
    "schema_version",
    "kind",
    "gate",
    "attempt",
    "check_id",
    "decision",
    "record_id",
    "binding_sha256",
    "considered",
    "considered_total"
  ],
  "additionalProperties": false
}
