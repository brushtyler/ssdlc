{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "invocations",
    "wall_seconds",
    "role_invocations",
    "phase_invocations",
    "transport_retries",
    "design_diagnoses",
    "metered_usd",
    "cli_estimate_usd",
    "development_attempts",
    "design_rounds",
    "invocation_timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "invocations": {
      "type": "integer",
      "minimum": 1
    },
    "wall_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "role_invocations": {
      "$ref": "#/$defs/caps"
    },
    "phase_invocations": {
      "$ref": "#/$defs/caps"
    },
    "transport_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "design_diagnoses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "metered_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cli_estimate_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "development_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "design_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "invocation_timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "historical_unknown_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocations",
        "metered_usd",
        "cli_estimate_usd"
      ],
      "properties": {
        "invocations": {
          "type": "integer",
          "minimum": 1
        },
        "metered_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cli_estimate_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "combined_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "unknown_usage_reserve_model": {
      "enum": [
        "exclusive_cost_kind_v1"
      ],
      "description": "Opt-in: an unknown invocation belongs to one cost kind. Each kind cap reserves its full allowance; the combined cap reserves the maximum once, not their sum. Absent retains additive legacy semantics."
    },
    "feedback_delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capability",
        "allowed_files",
        "max_amendments",
        "max_amendments_per_task",
        "max_added_files",
        "require_strong_independence"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "capability": {
          "const": "feedback-scope-delegation-v1"
        },
        "allowed_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_./-]+$"
          }
        },
        "require_strong_independence": {
          "const": true
        },
        "max_amendments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_amendments_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_added_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "feedback_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "roles"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "enabled": {
          "const": true
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planner",
            "reviewer"
          ],
          "properties": {
            "planner": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "model",
                "effort"
              ],
              "properties": {
                "engine": {
                  "enum": [
                    "claude",
                    "codex",
                    "agy"
                  ]
                },
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,119}$"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                }
              }
            },
            "reviewer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "model",
                "effort"
              ],
              "properties": {
                "engine": {
                  "enum": [
                    "claude",
                    "codex",
                    "agy"
                  ]
                },
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,119}$"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                }
              }
            },
            "po": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine",
                "model",
                "effort"
              ],
              "properties": {
                "engine": {
                  "enum": [
                    "claude",
                    "codex",
                    "agy"
                  ]
                },
                "model": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,119}$"
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh"
                  ]
                }
              }
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "issue"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "issue": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "caps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
