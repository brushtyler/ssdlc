{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate-findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_commit", "source_gate", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reviewed_commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
    "source_gate": {"enum": ["code_review", "qa", "appsec"]},
    "findings": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "classification", "evidence_kind", "scenario", "rationale",
                     "task_attribution", "file_refs", "obligation_refs", "evidence_refs",
                     "violates_existing_obligation", "introduces_regression",
                     "necessary_for_requested_correctness"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "classification": {"description": "Choose classification from the actual claim, not severity. mandatory_violation_or_regression requires violates_existing_obligation=true or introduces_regression=true and observed evidence. necessary_gap requires violates_existing_obligation=false, introduces_regression=false, necessary_for_requested_correctness=true and observed evidence. optional_improvement requires all three booleans=false. If correctness is not necessary and there is no existing violation/regression, choose optional_improvement or uncertain_needs_diagnosis, NEVER necessary_gap. Hypotheses cannot be mandatory violations or necessary gaps. Do not promote optional work to a mandatory claim merely to fit a label.",
                             "enum": ["mandatory_violation_or_regression", "necessary_gap",
                                      "optional_improvement", "uncertain_needs_diagnosis"]},
          "evidence_kind": {"enum": ["observed", "hypothesis"]},
          "scenario": {"type": "string", "minLength": 1, "maxLength": 4000},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
          "task_attribution": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "file_refs": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 512}},
          "obligation_refs": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "violates_existing_obligation": {"type": "boolean"},
          "introduces_regression": {"type": "boolean"},
          "necessary_for_requested_correctness": {"type": "boolean"}
        }
      }
    }
  }
}
