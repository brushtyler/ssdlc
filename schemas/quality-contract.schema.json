{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "source_id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "standard_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "standard_id",
          "description",
          "source_refs",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "timeout_sec": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "test",
              "lint",
              "types",
              "format"
            ]
          },
          "required": {
            "const": true
          }
        },
        "required": [
          "check_id",
          "argv",
          "cwd",
          "timeout_sec",
          "kind",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "baseline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "exit_code": {
            "type": "integer"
          },
          "log_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "check_id",
          "exit_code",
          "log_ref",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "standard_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "standard_id",
          "reason",
          "approved_by",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "contract_revision",
    "base_commit",
    "sources",
    "standards",
    "checks",
    "baseline",
    "limitations",
    "exceptions"
  ],
  "additionalProperties": false
}
